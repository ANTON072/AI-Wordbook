# ローカル開発用の環境変数テンプレート
# cp .env.local.example .env.local を実行し、各変数に実値を設定する
# .env.local は .gitignore で除外されているためシークレットを安全に記載できる
# 変数の詳細は docs/spec/003_architecture.md の「環境変数一覧」を参照

# Cognito ユーザープール ID（例：ap-northeast-1_XXXXXXXXX）
COGNITO_USER_POOL_ID=

# MCP 用 Cognito クライアント ID（パブリック／PKCE クライアント）
COGNITO_MCP_CLIENT_ID=

# Web 用 Cognito クライアント ID（コンフィデンシャル）
COGNITO_WEB_CLIENT_ID=

# Web OAuth コードフローのクライアントシークレット
COGNITO_WEB_CLIENT_SECRET=

# Cognito Hosted UI ドメイン（例：https://xxx.auth.ap-northeast-1.amazoncognito.com）
COGNITO_DOMAIN=

# DynamoDB テーブル名
DYNAMODB_TABLE_NAME=Wordbook

# Lambda ランタイムでは予約変数だが、ローカルでは明示指定する
AWS_REGION=ap-northeast-1

# アプリのベース URL（ローカルでは http://localhost:3000）
APP_BASE_URL=http://localhost:3000
